    "iPhone 15": ["6GB", "128GB/256GB"],
    "iPhone 15 Pro": ["8GB", "512GB"],
    "iPhone 15 Pro Max": ["8GB", "1TB"],
    "iPhone 16": ["8GB", "256GB"],
    "iPhone 16 Pro": ["8GB", "512GB"],
    "iPhone 16 Pro Max": ["12GB", "1TB"],
    "iPhone 17": ["12GB", "256GB"],
    "iPhone 17 Pro": ["12GB", "512GB"],
    "iPhone 17 Pro Max": ["16GB", "1TB"]
  },
  android: {
    "ROG Phone 8 Pro": ["24GB", "1TB"],
    "Galaxy S24 Ultra": ["12GB", "512GB"],
    "Poco F6 Pro": ["16GB", "512GB"],
    "RedMagic 9 Pro": ["16GB", "256GB"]
  }
};

let currentOS = "ios";

function switchOS(os) {
  currentOS = os;
  document.getElementById("iosBtn").classList.toggle("active", os === "ios");
  document.getElementById("androidBtn").classList.toggle("active", os === "android");
  loadDevices();
}

function loadDevices() {
  let select = document.getElementById("device");
  select.innerHTML = "";
  let list = devices[currentOS];
  for (let d in list) {
    let o = document.createElement("option");
    o.value = d; o.text = d;
    select.add(o);
  }
  updateStats();
}

function updateStats() {
  let select = document.getElementById("device");
  let data = devices[currentOS][select.value];
  document.getElementById("ram").innerText = data[0];
  document.getElementById("storage").innerText = data[1];
}

function toggleSwitch(el) {
  el.querySelector(".switch").classList.toggle("on");
}

function startAI() {
  let aiDiv = document.getElementById("ai");
  aiDiv.innerHTML = "";
  let steps = ["Connecting to Database...", "Patching Game Files...", "Setting Sensi > 120...", "Success!"];
  let i = 0;
  let interval = setInterval(() => {
    aiDiv.innerHTML += "> " + steps[i] + "<br>";
    i++;
    if (i >= steps.length) {
      clearInterval(interval);
      runProgress();
    }
  }, 400);
}

function runProgress() {
  // MINIMUM 120 LOGIC
  let base = Math.floor(Math.random() * 21) + 125; 
  
  document.getElementById("gen").innerText = base;
  document.getElementById("red").innerText = base + 10;
  document.getElementById("x2").innerText = base + 5;
  document.getElementById("x4").innerText = base + 2;
  document.getElementById("free").innerText = 200;

  let current = 0;
  let percentEl = document.getElementById("percent");
  let fill = document.getElementById("fill");

  let interval = setInterval(() => {
    current++;
    percentEl.innerText = "INJECTING: " + current + "%";
    fill.style.width = current + "%";
    if (current >= 100) clearInterval(interval);
  }, 20);
}

function cleanRAM() {
  let box = document.getElementById("matrix");
  box.style.display = "block";
  box.innerHTML = "";
  let i = 0;
  let interval = setInterval(() => {
    box.innerHTML += "Wiping 0x" + Math.random().toString(16).substr(2, 4).toUpperCase() + "... DONE<br>";
    box.scrollTop = box.scrollHeight;
    i += 4;
    if (i >= 100) { clearInterval(interval); box.innerHTML += "SYSTEM OPTIMIZED"; }
  }, 30);
}

loadDevices();
